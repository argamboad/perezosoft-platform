<Project>
  <!-- Every project's build settings are Perezosoft.Platform.Build's (Pkg 5.2, src/Build), imported here from source; an
       app takes the package instead. Beside them: the lockfiles (B11-6, R27 — restore settings, which no package can carry),
       the local source switch (Pkg 2.4) and the packing settings (Pkg 2.3). -->
  <Import Project="$(MSBuildThisFileDirectory)src/Build/buildTransitive/Perezosoft.Platform.Build.props" />
  <Import Project="$(MSBuildThisFileDirectory)build/PlatformSource.props" />
  <Import Project="$(MSBuildThisFileDirectory)build/Packing.props" />
  <PropertyGroup><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
</Project>
