<Project>
  <!-- The second halves, after each project's own content (Pkg 5.2): the build package's targets (LocalPorts), the local
       source switch's reference swap (Pkg 2.4), what a packable project ships (Pkg 3.1). -->
  <Import Project="$(MSBuildThisFileDirectory)src/Build/buildTransitive/Perezosoft.Platform.Build.targets" />
  <Import Project="$(MSBuildThisFileDirectory)build/PlatformSource.targets" />
  <Import Project="$(MSBuildThisFileDirectory)build/Packing.targets" />
</Project>
