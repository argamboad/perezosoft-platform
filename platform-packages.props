<Project>
  <!--
    The platform's package map (Pkg 2.4, ADR-034): every package the platform publishes, and the project in this repo
    that packs it. An app's local source switch (build/PlatformSource.targets, PLATFORM_SOURCE in the app's .env) reads
    this file FROM THE PLATFORM CHECKOUT it points at, and turns each PackageReference listed here into a
    ProjectReference to that project. PlatformSourceTests holds it to the packable projects: add a line in the same
    commit that makes a project packable.
  -->
  <ItemGroup>
    <PlatformPackage Include="Perezosoft.Platform.Core" Source="src/Core/Perezosoft.Core.csproj" />
    <PlatformPackage Include="Perezosoft.Platform.Infrastructure" Source="src/Infrastructure/Perezosoft.Infrastructure.csproj" />
    <PlatformPackage Include="Perezosoft.Platform.Api" Source="src/Api/Perezosoft.Api.csproj" />
    <PlatformPackage Include="Perezosoft.Platform.Client" Source="src/Client/Perezosoft.Client.csproj" />
    <PlatformPackage Include="Perezosoft.Platform.DryRun" Source="tools/release/dry-run/Perezosoft.Platform.DryRun.csproj" />
  </ItemGroup>
</Project>
