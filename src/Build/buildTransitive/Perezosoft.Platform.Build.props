<Project>

  <!--
    Perezosoft.Platform.Build, the props half (Pkg 5.2). Imported by the platform's Directory.Build.props from source, by
    an app's projects from the package (GlobalPackageReference), and by the local source switch from a platform checkout
    (build/PlatformSource.props) — once: the marker below stops a second import. A setting a project or its
    Directory.Build.props already made is kept.
  -->
  <PropertyGroup>
    <_PlatformBuildPropsImported>true</_PlatformBuildPropsImported>

    <!--
      Solution-wide build hygiene (audit B9-2). Nullable reference types on, and warnings are errors so the invariants the
      analyzers and the compiler check can't rot into ignored noise. This is half of "solid by construction" — the
      architecture tests (B9-1) are the other half, and CI (B9-3) runs both.
    -->
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <!--
      Two .resx entries with one name only warn (MSB3568) and the first value silently wins, so a slice can show
      another slice's text (v4 T9, R152). TreatWarningsAsErrors doesn't cover MSBuild warnings; promote exactly this
      one (a blanket MSBuildTreatWarningsAsErrors would also fail on the MAUI adb-reverse MSB3073). Held by
      ResourceParityTests.DuplicateResourceNames_FailTheBuild.
    -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MSB3568</MSBuildWarningsAsErrors>

    <!-- The repo's files these settings read, found from the project upward: the repo root holds them. -->
    <_PerezosoftLocalPorts>$([MSBuild]::GetPathOfFileAbove('local-ports.props', '$(MSBuildProjectDirectory)'))</_PerezosoftLocalPorts>
    <_PerezosoftPlatformStamp>$([MSBuild]::GetPathOfFileAbove('platform-stamp.json', '$(MSBuildProjectDirectory)'))</_PerezosoftPlatformStamp>
  </PropertyGroup>

  <!--
    The repo's local ports, stated once (Arch A10, #369): local-ports.props. A project that opts in with
    <GenerateLocalPorts>true</GenerateLocalPorts> gets an internal `LocalPorts` class generated from them (the targets
    half), so a dev fallback in code names LocalPorts.WebHttpsUrl, never a number. LocalPortsTests holds every other site
    to the same props.
  -->
  <Import Project="$(_PerezosoftLocalPorts)" Condition="'$(_PerezosoftLocalPorts)' != ''" />

  <!--
    The platform stamp travels with the API (Arch A2, R160): platform-stamp.json is copied beside the binaries of the
    *.Host project — the web app that runs, Pkg 3.2 — (and so into the published container), where /api/version reads the
    platform commit this build is synced to. The test host reads the same copy.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Host')) and '$(_PerezosoftPlatformStamp)' != ''">
    <Content Include="$(_PerezosoftPlatformStamp)" Link="platform-stamp.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
