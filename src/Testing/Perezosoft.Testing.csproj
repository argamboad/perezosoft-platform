<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The platform's test harness and guards (Pkg 5.1a, ADR-034 as amended: three test packages by runner — this one is
    xUnit's). The integration host and the database fixture, generic over the app's Program and AppDbContext; the
    service harness and its doubles; the fixture entities; the architecture guards and inspectors; the RLS setup and
    probe. An app's test assembly references it, declares its one-line host and fixture subclasses, and fills
    PlatformTestComposition from a module initializer. A library, not a test project: no test SDK, no runner.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>false</IsTestProject>
    <IsPackable>true</IsPackable>
    <PackageId>Perezosoft.Platform.Testing</PackageId>
    <Description>Perezosoft Platform test harness: the integration host and database fixture generic over an app's Program and context, the service harness, the architecture guards and the RLS probe, for xUnit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Testcontainers pulls a vulnerable SSH.NET transitively; the same pin the test projects carry. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="xunit.extensibility.core" />
    <PackageReference Include="xunit.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Perezosoft.Api.csproj" />
  </ItemGroup>

  <!--
    The register (Pkg 5.7, #450; 6.4, #423): every file of starter/ the ownership map classes `register`, embedded as the
    starter spells it (the placeholder brand AppBrand), so PlatformOwnershipSuite holds an app's copies to the package it
    references (the placeholder renamed to the app's brand) — no port, no checkout, no manifest file in the app.
    PlatformRegisterTests holds this list to the map: a file classed register in starter/ is embedded here, and nothing else.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\starter\.config\dotnet-tools.json" LogicalName="register/.config/dotnet-tools.json" />
    <EmbeddedResource Include="..\..\starter\.gitattributes" LogicalName="register/.gitattributes" />
    <EmbeddedResource Include="..\..\starter\Directory.Build.props" LogicalName="register/Directory.Build.props" />
    <EmbeddedResource Include="..\..\starter\Directory.Build.targets" LogicalName="register/Directory.Build.targets" />
    <EmbeddedResource Include="..\..\starter\build\PlatformSource.props" LogicalName="register/build/PlatformSource.props" />
    <EmbeddedResource Include="..\..\starter\build\PlatformSource.targets" LogicalName="register/build/PlatformSource.targets" />
    <EmbeddedResource Include="..\..\starter\docker\db\provision-rls-runtime-role.sql" LogicalName="register/docker/db/provision-rls-runtime-role.sql" />
    <EmbeddedResource Include="..\..\starter\global.json" LogicalName="register/global.json" />
    <EmbeddedResource Include="..\..\starter\nuget.config" LogicalName="register/nuget.config" />
    <EmbeddedResource Include="..\..\starter\platform-ownership.json" LogicalName="register/platform-ownership.json" />
    <EmbeddedResource Include="..\..\starter\src\Host\Program.cs" LogicalName="register/src/Host/Program.cs" />
    <EmbeddedResource Include="..\..\starter\src\Host\Persistence\AppDbContextFactory.cs" LogicalName="register/src/Host/Persistence/AppDbContextFactory.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\CompositionSmokeTests.cs" LogicalName="register/tests/Api.Tests/CompositionSmokeTests.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\Infrastructure\IntegrationTestFactory.cs" LogicalName="register/tests/Api.Tests/Infrastructure/IntegrationTestFactory.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\Infrastructure\PostgresFixture.cs" LogicalName="register/tests/Api.Tests/Infrastructure/PostgresFixture.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\Infrastructure\PostgresTestBase.cs" LogicalName="register/tests/Api.Tests/Infrastructure/PostgresTestBase.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\Infrastructure\TestAppDbContext.cs" LogicalName="register/tests/Api.Tests/Infrastructure/TestAppDbContext.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\OwnershipTests.cs" LogicalName="register/tests/Api.Tests/OwnershipTests.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\PlatformSchemaTests.cs" LogicalName="register/tests/Api.Tests/PlatformSchemaTests.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\PlatformTestingUsings.cs" LogicalName="register/tests/Api.Tests/PlatformTestingUsings.cs" />
    <EmbeddedResource Include="..\..\starter\tests\Api.Tests\TenancyTests.cs" LogicalName="register/tests/Api.Tests/TenancyTests.cs" />
  </ItemGroup>

</Project>
