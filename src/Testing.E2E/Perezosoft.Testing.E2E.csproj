<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The platform's journey harness (Pkg 5.1d, ADR-034 as amended: three test packages by runner — this one is NUnit's
    with Playwright). PlatformE2ETestBase drives a real browser against the running app; BlazorBoot reloads a dead
    WebAssembly boot (its decision in BlazorBootCore, Playwright-free so the API tests link and unit-test it); Mailpit
    reads the fake inbox; Totp computes MFA codes. An app's E2E project derives the base, adds its page objects and
    fills PlatformE2EHosts from its local ports. A library, not a test project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>false</IsTestProject>
    <IsPackable>true</IsPackable>
    <PackageId>Perezosoft.Platform.Testing.E2E</PackageId>
    <Description>Perezosoft Platform journey harness for NUnit and Playwright: the browser test base, the Blazor boot retry, the Mailpit inbox reader and the TOTP helper.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <!-- Compute TOTP codes from the enrollment secret for the MFA enroll+step-up journey. -->
    <PackageReference Include="Otp.NET" />
  </ItemGroup>

</Project>
