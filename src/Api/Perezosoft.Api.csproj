<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateLocalPorts>true</GenerateLocalPorts> <!-- LocalPorts.* from local-ports.props (Arch A10) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c0339958-6cea-40c1-8433-087f53b886e7</UserSecretsId>
    <!-- Published as a package (Pkg 3.1, ADR-034). Until the host is split out (Pkg 3.2) this is still the web app itself. -->
    <IsPackable>true</IsPackable>
    <!-- The Web SDK would pack the WASM debug-proxy's content files (a dozen .dll under contentFiles/): not part of the package. -->
    <IncludeContentInPack>false</IncludeContentInPack>
    <PackageId>Perezosoft.Platform.Api</PackageId>
    <Description>Perezosoft Platform API: controllers, auth, tenancy, billing, jobs and the endpoints every app inherits.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Serve the published Blazor WASM client single-origin (DEPLOY-1, ADR-017): UseBlazorFrameworkFiles. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Perezosoft.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\Perezosoft.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Perezosoft.Api.Tests" />
  </ItemGroup>

</Project>
