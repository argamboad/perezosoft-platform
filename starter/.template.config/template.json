{
  "$schema": "http://json.schemastore.org/template",
  "author": "Perezosoft",
  "classifications": [ "Web", "SaaS", "Blazor", "MAUI" ],
  "identity": "Perezosoft.Platform.Templates.App",
  "groupIdentity": "Perezosoft.Platform.App",
  "name": "Perezosoft platform app",
  "description": "An app on the Perezosoft platform packages: the host with the platform's API, a DELETE-ME Notes slice, its migrations, the platform's inherited suites, and the seeded UI (the web host, the pages in English and Spanish, their component tests), the MAUI app, and the browser journeys.",
  "shortName": "perezosoft-app",
  "tags": { "language": "C#", "type": "solution" },
  "sourceName": "AppBrand",
  "preferNameDirectory": true,
  "symbols": {
    "brandUpper": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "name", "toLower": false },
      "replaces": "APPBRAND"
    }
  },
  "sources": [
    {
      "copyOnly": [ "build/PlatformSource.props", "build/PlatformSource.targets", "global.json", "nuget.config", ".config/dotnet-tools.json", "platform-ownership.json", "**/*.png", "**/*.ico", "**/*.ttf", "src/Web/wwwroot/lib/**", "src/Maui/wwwroot/lib/**" ],
      "modifiers": [
        { "exclude": [ "**/bin/**", "**/obj/**", "**/packages.lock.json", "**/.vs/**", "**/node_modules/**", ".env" ] }
      ]
    }
  ]
}
